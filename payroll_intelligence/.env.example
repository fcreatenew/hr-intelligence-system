# Konfigurasi Payroll Intelligence.
# Salin menjadi .env dan sesuaikan. Jangan commit .env.

# Lokasi data payroll (relatif ke root repo).
PAYROLL_DATA_PATH=data/hr_payroll.csv

# HR Intelligence API (sumber model anomali payroll).
HR_INTELLIGENCE_BASE_URL=http://127.0.0.1:8000
HR_INTELLIGENCE_API_KEY=
HR_INTELLIGENCE_TIMEOUT=15

# Ambang anomali (fallback bila API tidak dipakai).
ANOMALY_THRESHOLD=0.5

# Parameter forecasting.
FORECAST_HORIZON=6
FORECAST_SEASONAL_PERIOD=12
