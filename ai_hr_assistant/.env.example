# =============================================================================
# Konfigurasi AI HR Assistant (Disesuaikan dengan Integrasi Hugging Face)
# =============================================================================

# --- HR Intelligence API (sumber prediksi model ML) ---
HR_INTELLIGENCE_BASE_URL=http://127.0.0.1:8000
HR_INTELLIGENCE_API_KEY=
HR_INTELLIGENCE_TIMEOUT=10
HR_INTELLIGENCE_RETRY_TIMES=2

# --- Auth API assistant ---
ASSISTANT_API_KEY=
ASSISTANT_RATE_LIMIT_PER_MINUTE=60

# --- Hugging Face Credentials (Wajib jika pakai Neural Embedding atau HF LLM) ---
HF_TOKEN=hf_token_anda_disini

# --- LLM provider ---
# mock   : untuk test/demo offline tanpa internet
# openai : pakai OPENAI_API_KEY
# hf     : pakai Hugging Face Inference API / Serverless
LLM_PROVIDER=hf
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Embeddings (Rekomendasi RAG: Neural dengan BAAI/bge-m3) ---
# Menggunakan model Hugging Face untuk hasil pencarian semantik & multilingual terbaik
EMBEDDING_BACKEND=lsa
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3

# --- Chunking ---
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=40

# --- Retrieval (RAG Strategy) ---
# fusion: rrf (Reciprocal Rank Fusion - menggabungkan leksikal & semantik)
RAG_FUSION=rrf
RAG_LEXICAL_WEIGHT=0.7
RAG_MMR=true
RAG_MMR_LAMBDA=0.7
RAG_TOP_K=4
RAG_MIN_SCORE=0.05