# Konfigurasi AI HR Assistant.
# Salin menjadi .env dan sesuaikan. Jangan commit .env.

# --- HR Intelligence API (sumber prediksi model ML) ---
HR_INTELLIGENCE_BASE_URL=http://127.0.0.1:8000
HR_INTELLIGENCE_API_KEY=
HR_INTELLIGENCE_TIMEOUT=10
HR_INTELLIGENCE_RETRY_TIMES=2

# --- LLM provider ---
# mock  : tidak butuh jaringan/model, jawaban disusun dari retrieval + tool.
#       Dipakai untuk test dan demo offline.
# openai: pakai OPENAI_API_KEY (opsional, butuh paket openai).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Embeddings ---
# lsa     : TF-IDF + SVD (semantik, tanpa model eksternal, deterministik) — default.
# hashing : feature hashing leksikal, tanpa fit, paling ringan.
# neural  : sentence-transformers (butuh paket & unduhan model).
EMBEDDING_BACKEND=lsa
EMBEDDING_DIM=256
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Chunking ---
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=40

# --- Retrieval ---
# fusion: rrf (default) | linear | lexical | semantic
RAG_FUSION=rrf
RAG_LEXICAL_WEIGHT=0.7
RAG_MMR=true
RAG_MMR_LAMBDA=0.7
RAG_TOP_K=4
RAG_MIN_SCORE=0.05
