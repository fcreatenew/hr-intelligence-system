# Dashboard React — env untuk DEPLOY.
# Vite membakar env saat BUILD (build arg di Dockerfile, env var di static site).

# demo = fixtures lokal (tanpa backend) | live = panggil API.
VITE_DATA_MODE=live

# Base path API. Untuk image nginx (proxy), biarkan `/api` dan `/payroll-api`.
# Untuk STATIC SITE tanpa proxy, isi URL publik API langsung:
#   VITE_HR_API_BASE=https://hr-api.onrender.com
#   VITE_PAYROLL_API_BASE=https://payroll-api.onrender.com
VITE_HR_API_BASE=/api
VITE_PAYROLL_API_BASE=/payroll-api

# Upstream nginx (dipakai image Docker, diproses envsubst saat start).
# Default docker-compose: http://hr-api:8000 / http://payroll-api:8300
HR_API_UPSTREAM=
PAYROLL_API_UPSTREAM=

# KOSONGKAN di produksi — pengguna memasukkan key lewat halaman login.
VITE_HR_API_KEY=
