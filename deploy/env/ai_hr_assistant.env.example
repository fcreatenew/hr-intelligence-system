# AI HR Assistant — env untuk DEPLOY.
# Demo offline gratis: LLM_PROVIDER=mock, EMBEDDING_BACKEND=lsa.

# mock   : deterministik dari retrieval + tool, TANPA jaringan (paling murah).
# openai : butuh OPENAI_API_KEY.
# hf     : Hugging Face Inference API (butuh HF_TOKEN, kuota free sangat kecil).
LLM_PROVIDER=mock
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
OPENAI_BASE_URL=
HF_TOKEN=

# Embeddings: lsa (lokal, gratis) | hashing (paling ringan) | neural (berat).
EMBEDDING_BACKEND=lsa
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3

# Auth API assistant. Kosong = menolak semua request (fail closed).
ASSISTANT_API_KEY=ganti-dengan-secret-acak
ASSISTANT_RATE_LIMIT_PER_MINUTE=60

# HR Intelligence API sebagai sumber tool prediksi.
# Di PaaS isi URL publik hr-api + API key-nya.
HR_INTELLIGENCE_BASE_URL=
HR_INTELLIGENCE_API_KEY=

# RAG
RAG_FUSION=rrf
RAG_LEXICAL_WEIGHT=0.7
RAG_MMR=true
RAG_MMR_LAMBDA=0.7
RAG_TOP_K=4
RAG_MIN_SCORE=0.05

HR_NUM_THREADS=1
