# HRIS Laravel — env untuk DEPLOY.
# CATATAN: SQLite ephemeral di PaaS — data reset tiap redeploy/restart.
# Untuk persistensi, pindah ke Postgres (Neon/Supabase) dan ubah DB_*.

APP_NAME="HR Application"
APP_ENV=production
APP_DEBUG=false
APP_URL=

# WAJIB. Generate: php artisan key:generate --show
APP_KEY=

# --- Database ---
# Demo cepat: sqlite (file di dalam container, tidak persisten).
DB_CONNECTION=sqlite
# Persisten (Neon/Supabase):
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Integrasi ML ---
# Di PaaS isi URL publik service (bukan http://hr-api:8000).
HR_INTELLIGENCE_BASE_URL=
HR_INTELLIGENCE_API_KEY=
HR_INTELLIGENCE_TIMEOUT=10
HR_INTELLIGENCE_RETRY_TIMES=3
HR_INTELLIGENCE_RETRY_DELAY_MS=300
HR_INTELLIGENCE_BATCH_CHUNK_SIZE=500
HR_INTELLIGENCE_RETENTION_DAYS=365

PAYROLL_INTELLIGENCE_BASE_URL=
PAYROLL_INTELLIGENCE_TIMEOUT=10
