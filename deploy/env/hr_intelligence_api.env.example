# HR Intelligence API — env untuk DEPLOY (Render/Koyeb/VPS).
# Salin nilai ke dashboard platform (Environment / Secrets). JANGAN commit .env asli.

# Versi model turnover aktif (artifact di models/<versi>/).
MODEL_VERSION=v2_mitigated

# WAJIB. Kosong = API menolak semua request (fail closed).
# Render: biarkan `generateValue: true` di render.yaml.
HR_API_KEY=ganti-dengan-secret-acak

# Origin browser yang boleh mengakses API. Di PaaS isi URL dashboard.
# Bila dashboard memakai nginx reverse proxy (satu origin), ini bisa dikosongkan.
# Contoh: https://dashboard.onrender.com
CORS_ALLOW_ORIGINS=

RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=5000
LOG_LEVEL=INFO

# Dokumentasi interaktif. Biarkan false di demo publik.
ENABLE_DOCS=false

# Batasi thread BLAS/OpenMP (CPU-only, 1 worker per container).
HR_NUM_THREADS=1
