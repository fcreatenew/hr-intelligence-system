# Payroll Intelligence — env untuk DEPLOY.
# Data dibaca dari data/hr_payroll.csv (ikut ter-copy ke image Docker).

# Path dataset. Default relatif ke root repo di dalam image.
# PAYROLL_DATA_PATH=data/hr_payroll.csv

# Ambang skor anomali (0..1).
ANOMALY_THRESHOLD=0.5

FORECAST_HORIZON=6
FORECAST_SEASONAL_PERIOD=12

# Opsional: bila payroll perlu memanggil HR Intelligence API.
HR_INTELLIGENCE_BASE_URL=
HR_INTELLIGENCE_API_KEY=

HR_NUM_THREADS=1
