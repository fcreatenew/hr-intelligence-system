APP_TITLE=HR Intelligence API
APP_VERSION=1.0.0

# Versi model aktif (artifact ada di models/<MODEL_VERSION>/).
MODEL_VERSION=v2

# Opsional: override path eksplisit. Kosongkan untuk memakai MODEL_VERSION di atas.
# MODEL_PATH=models/v2/turnover_model.joblib
# METADATA_PATH=models/v2/model_metadata.json

HR_API_KEY=dev-only-change-me

RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=5000

LOG_LEVEL=INFO