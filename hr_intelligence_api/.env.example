# HR Intelligence API — contoh konfigurasi.
# Salin ke .env lalu sesuaikan. Jangan commit .env asli.

# Versi model turnover aktif (artifact ada di models/<MODEL_VERSION>/).
# Default v2_mitigated = versi paling adil (bias termitigasi).
MODEL_VERSION=v2_mitigated

# API key wajib. Kosong = API mengembalikan 500 (fail closed).
HR_API_KEY=dev-only-change-me

RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=5000

LOG_LEVEL=INFO

# Dokumentasi interaktif (Swagger/ReDoc/OpenAPI). Nonaktif di produksi.
ENABLE_DOCS=false

# Origin browser yang diizinkan (dipisah koma). Kosong = CORS nonaktif.
# Contoh: CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ALLOW_ORIGINS=
