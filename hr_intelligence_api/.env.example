# HR Intelligence API — contoh konfigurasi.
# Salin ke .env lalu sesuaikan. Jangan commit .env asli.

# Versi model turnover aktif (artifact diambil dari Hugging Face Hub).
# Default v2_mitigated = versi paling adil (bias termitigasi).
MODEL_VERSION=v2_mitigated

# --- Sumber artifact model (Hugging Face Hub) ------------------------------
# Runtime TIDAK lagi membaca model dari disk lokal. Semua artifact diunduh
# dari satu repo Hub lalu di-cache (HF_HOME).
HR_MODEL_REPO=fcreatenew/hr-intelligence-models
HR_MODEL_REPO_TYPE=model
HR_MODEL_REVISION=main
# Token Hub: cukup untuk repo publik/privat (read). Gunakan HF_TOKEN.
# HF_TOKEN=

# Mode sumber artifact. Biarkan `hub` untuk produksi. Set `local` hanya untuk
# pengembangan/test offline (membaca folder models/ di repo).
# HR_MODEL_SOURCE=hub

# Lokasi cache unduhan (opsional; default ~/.cache/huggingface).
# HF_HOME=/data/hf-cache

# API key wajib. Kosong = API mengembalikan 500 (fail closed).
HR_API_KEY=dev-only-change-me

RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=5000

LOG_LEVEL=INFO

# Dokumentasi interaktif (Swagger/ReDoc/OpenAPI). Nonaktif di produksi.
ENABLE_DOCS=false

# Origin browser yang diizinkan (dipisah koma). Kosong = CORS nonaktif.
# Contoh: CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ALLOW_ORIGINS=
