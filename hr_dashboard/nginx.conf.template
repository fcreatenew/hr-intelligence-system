# Konfigurasi nginx untuk image produksi hr_dashboard.
#
# Dashboard mode `live` memanggil `/api` dan `/payroll-api` (lihat
# src/services/api.js). Di dev proxy ditangani Vite; di container diteruskan
# nginx ke service backend.
#
# Nama host TIDAK hardcoded: file ini adalah template yang diproses
# `envsubst` saat container start (entrypoint resmi image nginx membaca
# /etc/nginx/templates/*.template). Default docker-compose lokal:
#   HR_API_UPSTREAM=http://hr-api:8000
#   PAYROLL_API_UPSTREAM=http://payroll-api:8300
# Di PaaS, keduanya diisi URL publik service masing-masing (lihat render.yaml).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # HR Intelligence API (prediksi model ML).
    location /api/ {
        proxy_pass ${HR_API_UPSTREAM}/;
        proxy_set_header Host $host;
    }

    # Payroll Intelligence API (analitik payroll).
    location /payroll-api/ {
        proxy_pass ${PAYROLL_API_UPSTREAM}/;
        proxy_set_header Host $host;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
