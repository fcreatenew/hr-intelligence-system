# Mode data: "demo" (fixtures lokal) atau "live" (panggil API).
VITE_DATA_MODE=demo

# Base path API (dipangkas oleh proxy dev).
VITE_HR_API_BASE=/api
VITE_PAYROLL_API_BASE=/payroll-api

# API key bootstrap untuk dev agar tidak perlu login tiap kali.
# KOSONGKAN di produksi — pengguna memasukkan key lewat halaman login.
VITE_HR_API_KEY=
