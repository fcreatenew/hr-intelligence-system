# Konfigurasi Deep Learning.
# Salin menjadi .env dan sesuaikan. Jangan commit .env.

# Lokasi dataset turnover.
DEEP_LEARNING_TURNOVER_DATA=data/hr_turnover.csv

# Tanggal acuan fitur turnover (harus sama dengan hr_intelligence_api).
DEEP_LEARNING_REF_DATE=2025-01-01

# Reproduksibilitas.
DEEP_LEARNING_SEED=42

# Arsitektur MLP.
DEEP_LEARNING_HIDDEN=64,32
DEEP_LEARNING_LR=0.01
DEEP_LEARNING_EPOCHS=200
DEEP_LEARNING_BATCH_SIZE=64
DEEP_LEARNING_PATIENCE=20
DEEP_LEARNING_VAL_FRACTION=0.2
